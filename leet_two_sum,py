class Solution:   
    def twoSum(self, nums: list[int], target: int) -> list[int]:
        for i, num in enumerate(nums):
            remaining=target-num
            if remaining in nums[i+1:]:
                j=nums.index(remaining,i+1)
                return[i,j]


                

